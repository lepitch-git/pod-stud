# Copier ce fichier en .env pour le développement local. Ne jamais committer le .env.
# Les services ci-dessous sont fournis par docker-compose.yml (utiles à partir des étapes 3 et 5).
DATABASE_URL=postgresql://podstud:podstud@localhost:5432/podstud
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=podstud-dev
S3_ACCESS_KEY=podstud
S3_SECRET_KEY=podstud-dev-secret
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
